{
  "manifest_version": 3,
  "name": "Google to Bing Redirect",
  "version": "1.0.0",
  "description": "Redirect Google home and search pages to Bing.",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://google.com/*",
    "http://www.google.com/*",
    "https://google.com/*",
    "https://www.google.com/*",
    "https://www.bing.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "google_to_bing",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
